<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TestTargets>net35;net40;net45;net451;net452;net46;net461;net462;net47;net471;net472;net48;netcoreapp3.1;net5.0</TestTargets>
    <TestTargets Condition="$(LightBuild)">net472;netcoreapp3.1;net5.0</TestTargets>
    <TargetFrameworks>$(TestTargets)</TargetFrameworks>

    <Title>QuikGraph.Data.Tests</Title>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>

    <Copyright>Copyright © 2020</Copyright>
    <Description>Tests for QuikGraph.Data library.</Description>
  </PropertyGroup>

  <!-- Dependencies -->
  <!-- Shared Projects -->
  <Import Project="..\..\src\QuikGraph.CommonInternals\QuikGraph.CommonInternals.projitems" Label="Shared" />

  <!-- Projects -->
  <!-- QuikGraph.Data reference -->
  <ItemGroup Condition="$(UseQuikGraphDataNuget)">
    <PackageReference Include="QuikGraph.Data" Version="2.5.0" />
  </ItemGroup>
  <ItemGroup Condition="!$(UseQuikGraphDataNuget)">
    <ProjectReference Include="..\..\src\QuikGraph.Data\QuikGraph.Data.csproj" />
  </ItemGroup>
</Project>